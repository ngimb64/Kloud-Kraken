{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server Launch",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/kloud-kraken/main.go",
            "args": ["../../config/config.yml"],
            "debugAdapter": "dlv-dap",
            "stopOnEntry": false,
        },
        {
            "name": "Client Launch",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/service/client.go",
            "args": [
                "-applyOptimization=false",
                "-awsRegion=us-east-1",
                "-crackingMode=0",
                "-dataPath=/tmp",
                "-hashType=1700",
                "-ipAddrs=10.0.0.17",
                "-logMode=local",
                "-maxFileSizeInt64=17179869184",
                "-maxTransfers=2",
                "-port=7003",
                "-workload=3"
            ],
            "stopOnEntry": false
        }
    ]
}